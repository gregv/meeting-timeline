<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="AgendaClock - turn your meetings into a SpaceX Launch!">
    <meta name="author" content="Greg Vanoni">

    <title>Edit · <%= meeting.title %></title>
    <% include meeting_header %>
    <link href="/css/edit_meeting.css?v=1" rel="stylesheet">
  </head>
  <body class="bg-light">

<div class="container-fluid editor-shell">
  <!-- Header bar -->
  <div class="editor-header d-flex justify-content-between align-items-center flex-wrap">
    <div class="d-flex align-items-center">
      <a class="btn btn-outline-secondary btn-sm mr-3" href="/meeting/">
        <img src="/images/house.svg" alt="" style="width: 14px; margin-right: 4px;"/> Home
      </a>
      <h4 class="mb-0">✏️ <%= meeting.title %></h4>
    </div>
    <div class="d-flex align-items-center">
      <span id="saveIndicator" class="save-indicator is-saved mr-3">● Saved</span>
      <button id="saveNow" class="btn btn-outline-primary btn-sm mr-2" type="button">Save now</button>
      <a id="openTimeline" class="btn btn-primary btn-sm" href="/meeting/<%= id %>?view=<%= meeting.default_view %>&chrome=1" target="_blank">
        <img src="/images/eye.svg" alt="" style="width: 14px; margin-right: 4px;"/> Open timeline ↗
      </a>
    </div>
  </div>

  <form id="editorForm" action="/meeting/<%= id %>" method="POST" autocomplete="off">
    <input type="hidden" name="meeting_id" value="<%= id %>"/>
    <input type="hidden" name="preset" id="presetField" value="<%= meeting.preset || '' %>"/>

    <div class="row">
      <!-- ============ LEFT: form ============ -->
      <div class="col-lg-5">

        <!-- Basics -->
        <div class="card editor-card">
          <div class="card-header">📋 Basics</div>
          <div class="card-body">
            <div class="form-group">
              <label for="title">Meeting title</label>
              <input type="text" name="title" class="form-control" id="title"
                     value="<%= meeting.title %>" maxlength="200" required>
            </div>
            <div class="form-row">
              <div class="form-group col-sm-5">
                <label for="start_time_input">Start time</label>
                <div class="input-group time timepicker">
                  <input name="start_time" id="start_time_input" class="form-control"
                         value="<%= meeting.start_time %>" placeholder="9:00 AM">
                  <span class="input-group-append">
                    <span class="input-group-text"><i class="fa fa-clock"></i></span>
                  </span>
                </div>
              </div>
              <div class="form-group col-sm-7">
                <label for="timezone">Timezone</label>
                <select class="form-control" name="timezone" id="timezone" required>
                  <option value="<%= meeting.timezone %>" selected><%= meeting.timezone %></option>
                  <% all_timezones.forEach(function(tz) { if (tz !== meeting.timezone) { %>
                    <option><%= tz %></option>
                  <% } }); %>
                </select>
              </div>
            </div>
            <div class="custom-control custom-switch">
              <input type="checkbox" class="custom-control-input" name="is_public" id="is_public"
                     <%= meeting.is_public ? 'checked' : '' %>>
              <label class="custom-control-label" for="is_public">
                <strong>🌐 Public link</strong><br>
                <small class="text-muted">Anyone with the link can view this timeline — no login needed.
                Required for sharing with attendees and for OBS. Only you can edit.</small>
              </label>
            </div>
          </div>
        </div>

        <!-- Agenda -->
        <div class="card editor-card">
          <div class="card-header d-flex justify-content-between align-items-center">
            <span>🎯 Agenda</span>
            <small class="text-muted">drag ⠿ to reorder</small>
          </div>
          <div class="card-body">
            <template id="agendaRowTemplate">
              <li class="agenda-row list-group-item">
                <span class="drag-handle" title="Drag to reorder">⠿</span>
                <input type="text" class="form-control form-control-sm agenda-person" name="person" value="" placeholder="Who">
                <input type="text" class="form-control form-control-sm agenda-topic" name="topic" value="" placeholder="Topic" required>
                <div class="input-group input-group-sm agenda-duration-group">
                  <input type="number" class="form-control agenda-duration" name="duration" value="" min="1" max="480" placeholder="min">
                  <div class="input-group-append"><span class="input-group-text">min</span></div>
                </div>
                <button class="btn btn-sm btn-outline-danger remove-row" type="button" title="Remove">🗑</button>
              </li>
            </template>

            <ul class="list-group agenda-list" id="agendaList">
              <%
                var personsArr = Array.isArray(meeting.person) ? meeting.person : (meeting.person != null ? [meeting.person] : []);
                var topicsArr = Array.isArray(meeting.topic) ? meeting.topic : (meeting.topic != null ? [meeting.topic] : []);
                var durationsArr = Array.isArray(meeting.duration) ? meeting.duration : (meeting.duration != null ? [meeting.duration] : []);
              %>
              <% topicsArr.forEach(function(topic, index) { %>
              <li class="agenda-row list-group-item">
                <span class="drag-handle" title="Drag to reorder">⠿</span>
                <input type="text" class="form-control form-control-sm agenda-person" name="person" value="<%= personsArr[index] || '' %>" placeholder="Who">
                <input type="text" class="form-control form-control-sm agenda-topic" name="topic" value="<%= topic %>" placeholder="Topic" required>
                <div class="input-group input-group-sm agenda-duration-group">
                  <input type="number" class="form-control agenda-duration" name="duration" value="<%= durationsArr[index] || '' %>" min="1" max="480" placeholder="min">
                  <div class="input-group-append"><span class="input-group-text">min</span></div>
                </div>
                <button class="btn btn-sm btn-outline-danger remove-row" type="button" title="Remove">🗑</button>
              </li>
              <% }); %>
            </ul>

            <button class="btn btn-outline-primary btn-sm btn-block mt-2" id="addAgendaRow" type="button">＋ Add agenda item</button>

            <div class="agenda-totals mt-3" id="agendaTotals">
              <!-- filled by JS: "N items · 45 min total · ends 10:47 AM" -->
            </div>
          </div>
        </div>

        <!-- Appearance -->
        <div class="card editor-card">
          <div class="card-header">🎨 Appearance</div>
          <div class="card-body">
            <label class="d-block">Style preset</label>
            <div class="preset-row" id="presetRow">
              <button type="button" class="preset-card" data-preset="mission-control">
                <span class="preset-swatches">
                  <span style="background:#404040"></span><span style="background:#FF6600"></span><span style="background:#0099CC"></span>
                </span>
                🚀 Mission Control
              </button>
              <button type="button" class="preset-card" data-preset="minimal">
                <span class="preset-swatches">
                  <span style="background:#3A3F4A"></span><span style="background:#FFFFFF"></span><span style="background:#5A6478"></span>
                </span>
                ◽ Minimal
              </button>
              <button type="button" class="preset-card" data-preset="high-contrast">
                <span class="preset-swatches">
                  <span style="background:#2E2E2E"></span><span style="background:#FF9500"></span><span style="background:#00B3FF"></span>
                </span>
                🔆 High Contrast
              </button>
            </div>
            <small class="text-muted d-block mt-1" id="presetHint"></small>
            <button type="button" class="btn btn-link btn-sm px-0" id="resetDefaults">↺ Reset to defaults</button>
          </div>
        </div>

        <!-- Advanced -->
        <div class="card editor-card">
          <div class="card-header advanced-toggle" data-toggle="collapse" data-target="#advancedBody" role="button" aria-expanded="false">
            ⚙️ Advanced settings <span class="text-muted small">(fonts, colors, marker)</span>
            <span class="float-right">▾</span>
          </div>
          <div class="collapse" id="advancedBody">
            <div class="card-body">

              <h6 class="adv-heading">Chroma key background (OBS)</h6>
              <div class="form-row align-items-center">
                <div class="col-auto">
                  <input type="color" id="backgroundPicker" class="form-control color-swatch" value="#<%= meeting.background || '0047BB' %>">
                </div>
                <div class="col">
                  <input type="text" id="background" name="background" class="form-control form-control-sm"
                         value="<%= meeting.background || '0047BB' %>" pattern="^[0-9A-Fa-f]{6}$" placeholder="0047BB">
                </div>
              </div>

              <h6 class="adv-heading">Fonts</h6>
              <div class="form-row">
                <div class="form-group col-4">
                  <label class="small">Title size</label>
                  <input type="number" class="form-control form-control-sm" name="titleFontSize" min="16" max="48" value="<%= meeting.config.titleFontSize %>">
                </div>
                <div class="form-group col-4">
                  <label class="small">Block text</label>
                  <input type="number" class="form-control form-control-sm" name="blockFontSize" min="8" max="24" value="<%= meeting.config.blockFontSize %>">
                </div>
                <div class="form-group col-4">
                  <label class="small">Time labels</label>
                  <input type="number" class="form-control form-control-sm" name="timeLabelFontSize" min="6" max="18" value="<%= meeting.config.timeLabelFontSize %>">
                </div>
              </div>

              <h6 class="adv-heading">Status colors</h6>
              <div class="form-row">
                <div class="form-group col-4">
                  <label class="small">✓ Done</label>
                  <div class="d-flex">
                    <input type="color" id="completedColorPicker" class="color-swatch-sm" value="#<%= meeting.config.colors.completed %>">
                    <input type="text" id="completedColor" name="completedColor" class="form-control form-control-sm ml-1"
                           value="<%= meeting.config.colors.completed %>" pattern="^[0-9A-Fa-f]{6}$">
                  </div>
                </div>
                <div class="form-group col-4">
                  <label class="small">▶ Current</label>
                  <div class="d-flex">
                    <input type="color" id="currentColorPicker" class="color-swatch-sm" value="#<%= meeting.config.colors.current %>">
                    <input type="text" id="currentColor" name="currentColor" class="form-control form-control-sm ml-1"
                           value="<%= meeting.config.colors.current %>" pattern="^[0-9A-Fa-f]{6}$">
                  </div>
                </div>
                <div class="form-group col-4">
                  <label class="small">○ Upcoming</label>
                  <div class="d-flex">
                    <input type="color" id="upcomingColorPicker" class="color-swatch-sm" value="#<%= meeting.config.colors.upcoming %>">
                    <input type="text" id="upcomingColor" name="upcomingColor" class="form-control form-control-sm ml-1"
                           value="<%= meeting.config.colors.upcoming %>" pattern="^[0-9A-Fa-f]{6}$">
                  </div>
                </div>
              </div>

              <h6 class="adv-heading">Time marker (overlay view)</h6>
              <div class="form-row">
                <div class="form-group col-6">
                  <label class="small">Primary color</label>
                  <div class="d-flex">
                    <input type="color" id="markerPrimaryColorPicker" class="color-swatch-sm" value="#<%= meeting.config.timeMarker.primaryColor %>">
                    <input type="text" id="markerPrimaryColor" name="markerPrimaryColor" class="form-control form-control-sm ml-1"
                           value="<%= meeting.config.timeMarker.primaryColor %>" pattern="^[0-9A-Fa-f]{6}$">
                  </div>
                </div>
                <div class="form-group col-6">
                  <label class="small">Glow color</label>
                  <div class="d-flex">
                    <input type="color" id="markerSecondaryColorPicker" class="color-swatch-sm" value="#<%= meeting.config.timeMarker.secondaryColor %>">
                    <input type="text" id="markerSecondaryColor" name="markerSecondaryColor" class="form-control form-control-sm ml-1"
                           value="<%= meeting.config.timeMarker.secondaryColor %>" pattern="^[0-9A-Fa-f]{6}$">
                  </div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group col-3">
                  <label class="small">Line width</label>
                  <input type="number" class="form-control form-control-sm" name="markerLineWidth" min="1" max="10" value="<%= meeting.config.timeMarker.lineWidth %>">
                </div>
                <div class="form-group col-3">
                  <label class="small">Circle size</label>
                  <input type="number" class="form-control form-control-sm" name="markerCircleSize" min="3" max="20" value="<%= meeting.config.timeMarker.circleSize %>">
                </div>
                <div class="form-group col-3">
                  <label class="small">Height</label>
                  <input type="number" class="form-control form-control-sm" name="markerHeight" min="50" max="200" value="<%= meeting.config.timeMarker.height %>">
                </div>
                <div class="form-group col-3">
                  <label class="small">Style</label>
                  <select class="form-control form-control-sm" name="markerStyle">
                    <option value="modern" <%= meeting.config.timeMarker.style === 'modern' ? 'selected' : '' %>>Modern</option>
                    <option value="classic" <%= meeting.config.timeMarker.style === 'classic' ? 'selected' : '' %>>Classic</option>
                    <option value="minimal" <%= meeting.config.timeMarker.style === 'minimal' ? 'selected' : '' %>>Minimal</option>
                    <option value="arrow" <%= meeting.config.timeMarker.style === 'arrow' ? 'selected' : '' %>>Arrow</option>
                  </select>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group col-3">
                  <label class="small">Pulse (ms)</label>
                  <input type="number" class="form-control form-control-sm" name="markerPulseSpeed" min="50" max="1000" value="<%= meeting.config.timeMarker.pulseSpeed %>">
                </div>
                <div class="form-group col-3">
                  <label class="small">Glow (0–1)</label>
                  <input type="number" class="form-control form-control-sm" name="markerGlowIntensity" min="0" max="1" step="0.1" value="<%= meeting.config.timeMarker.glowIntensity %>">
                </div>
                <div class="form-group col-3">
                  <label class="small">Text size</label>
                  <input type="number" class="form-control form-control-sm" name="markerTextSize" min="8" max="24" value="<%= meeting.config.timeMarker.textStyle.fontSize %>">
                </div>
                <div class="form-group col-3">
                  <label class="small">Text color</label>
                  <div class="d-flex">
                    <input type="color" id="markerTextColorPicker" class="color-swatch-sm" value="#<%= meeting.config.timeMarker.textStyle.color %>">
                    <input type="text" id="markerTextColor" name="markerTextColor" class="form-control form-control-sm ml-1"
                           value="<%= meeting.config.timeMarker.textStyle.color %>" pattern="^[0-9A-Fa-f]{6}$">
                  </div>
                </div>
              </div>
              <div class="form-row">
                <div class="form-group col-6">
                  <label class="small">Text background</label>
                  <div class="d-flex">
                    <input type="color" id="markerTextBgPicker" class="color-swatch-sm" value="#<%= meeting.config.timeMarker.textStyle.backgroundColor %>">
                    <input type="text" id="markerTextBg" name="markerTextBg" class="form-control form-control-sm ml-1"
                           value="<%= meeting.config.timeMarker.textStyle.backgroundColor %>" pattern="^[0-9A-Fa-f]{6}$">
                  </div>
                </div>
              </div>
              <div class="adv-switch-grid">
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="markerShowLine" id="markerShowLine" <%= meeting.config.timeMarker.showLine ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="markerShowLine">Marker line</label>
                </div>
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="markerShowCircle" id="markerShowCircle" <%= meeting.config.timeMarker.showCircle ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="markerShowCircle">Marker circle</label>
                </div>
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="markerShowGlow" id="markerShowGlow" <%= meeting.config.timeMarker.showGlow ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="markerShowGlow">Marker glow</label>
                </div>
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="markerTextShowBg" id="markerTextShowBg" <%= meeting.config.timeMarker.textStyle.showBackground ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="markerTextShowBg">Text background</label>
                </div>
              </div>

              <h6 class="adv-heading">Display</h6>
              <div class="adv-switch-grid">
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="showProgressBars" id="showProgressBars" <%= meeting.config.showProgressBars ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="showProgressBars">Progress bars</label>
                </div>
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="showStatusIcons" id="showStatusIcons" <%= meeting.config.showStatusIcons ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="showStatusIcons">Status icons</label>
                </div>
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="showTimeLabels" id="showTimeLabels" <%= meeting.config.showTimeLabels ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="showTimeLabels">Time labels</label>
                </div>
                <div class="custom-control custom-switch">
                  <input type="checkbox" class="custom-control-input" name="showDebug" id="showDebug" <%= meeting.config.showDebug ? 'checked' : '' %>>
                  <label class="custom-control-label small" for="showDebug">Debug info</label>
                </div>
              </div>
              <div class="form-row mt-2">
                <div class="form-group col-6">
                  <label class="small">Segment height</label>
                  <input type="number" class="form-control form-control-sm" name="segmentHeight" min="30" max="100" value="<%= meeting.config.segmentHeight %>">
                </div>
                <div class="form-group col-6">
                  <label class="small">Animation speed</label>
                  <input type="number" class="form-control form-control-sm" name="animationSpeed" min="0.1" max="3.0" step="0.1" value="<%= meeting.config.animationSpeed %>">
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

      <!-- ============ RIGHT: share + live preview ============ -->
      <div class="col-lg-7">
        <div class="sticky-col">

          <!-- Share -->
          <div class="card editor-card">
            <div class="card-header">🔗 Share</div>
            <div class="card-body">
              <div class="alert alert-warning py-2 px-3 mb-3" id="shareWarning" style="display: none;">
                ⚠️ This link only works for you. Turn on <strong>Public link</strong> in Basics to share it.
              </div>

              <label class="d-block mb-1">How should the shared link look?</label>
              <%
                var view_labels = {
                  overlay: '📺 Overlay', liftoff: '🚀 Liftoff', rail: '🚇 Rail',
                  table: '📋 Table', focus: '🎯 Focus', ring: '⭕ Ring'
                };
              %>
              <div class="btn-group btn-group-toggle view-pills mb-3" data-toggle="buttons" id="viewPills">
                <% view_modes.forEach(function(mode) { %>
                <label class="btn btn-sm btn-outline-secondary <%= meeting.default_view === mode ? 'active' : '' %>">
                  <input type="radio" name="default_view" value="<%= mode %>" <%= meeting.default_view === mode ? 'checked' : '' %>>
                  <%= view_labels[mode] || mode %>
                </label>
                <% }); %>
              </div>

              <div class="d-flex share-row">
                <div class="flex-grow-1 mr-3">
                  <div class="input-group input-group-sm mb-2">
                    <input type="text" class="form-control" id="shareUrl" readonly>
                    <div class="input-group-append">
                      <button class="btn btn-primary" type="button" id="copyShareUrl">Copy</button>
                    </div>
                  </div>
                  <button class="btn btn-outline-secondary btn-sm" type="button" id="copyObsUrl" title="Overlay view with transparency and no on-screen UI — paste into an OBS Browser Source">
                    🎥 Copy OBS URL
                  </button>
                  <a class="btn btn-link btn-sm" data-toggle="collapse" href="#obsHelp" role="button">How do I use this with OBS?</a>
                  <div class="collapse mt-2" id="obsHelp">
                    <div class="obs-help small">
                      <ol class="pl-3 mb-2">
                        <li>Make the meeting <strong>Public</strong> (OBS can't log in).</li>
                        <li>In OBS, add your webcam (<em>Video Capture Device</em>), then add a <em>Browser</em> source <strong>above</strong> it.</li>
                        <li>Paste the <strong>OBS URL</strong> (button above), set size 1920×1080. The background is transparent — your camera shows through automatically.</li>
                        <li>Click <em>Start Virtual Camera</em>, then pick “OBS Virtual Camera” in Zoom/Meet/Teams.</li>
                      </ol>
                      <a href="/obs-setup" target="_blank">Full OBS setup guide with screenshots →</a>
                    </div>
                  </div>
                </div>
                <div class="text-center">
                  <div id="shareQr" class="share-qr"></div>
                  <small class="text-muted">Scan to open</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Live preview -->
          <div class="card editor-card">
            <div class="card-header d-flex justify-content-between align-items-center">
              <span>👁 Live preview <small class="text-muted">(saves automatically, then refreshes)</small></span>
              <button class="btn btn-sm btn-outline-secondary" type="button" id="refreshPreview">↻ Refresh</button>
            </div>
            <div class="preview-frame-wrap" id="previewWrap">
              <iframe id="previewFrame" title="Timeline preview" width="1920" height="1080"></iframe>
            </div>
          </div>

        </div>
      </div>
    </div>
  </form>
</div>

<% include meeting_footer %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
  // Server-provided context for edit_meeting.js
  window.EDITOR = {
    meetingId: "<%= id %>",
    isPublic: <%= meeting.is_public ? 'true' : 'false' %>,
    defaultView: "<%= meeting.default_view %>"
  };
</script>
<script src="/js/edit_meeting.js?v=1"></script>

  </body>
</html>
